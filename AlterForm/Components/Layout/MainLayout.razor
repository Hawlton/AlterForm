@using AlterForm.Client.Pages.Islands
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<CascadingAuthenticationState>
<RadzenComponents @rendermode="InteractiveWebAssembly"></RadzenComponents>
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center", JustifyContent="JustifyContent.SpaceBetween" Style="padding-inline: 10px">
            <div class="header-segment">
                <MainMenu></MainMenu>
                <h3>AlterForm</h3>
            </div>
            <AuthorizeView>
                <Authorized>
                    <RadzenProfileMenu>
                        <Template>
                            <img src="favicon.png" />
                        </Template>
                        <ChildContent>
                            <RadzenProfileMenuItem Text="My Gallery" Icon="art_track"></RadzenProfileMenuItem>
                            <RadzenProfileMenuItem Text="Account Settings" Icon="settings"></RadzenProfileMenuItem>
                        </ChildContent>
                    </RadzenProfileMenu>
                </Authorized>
                <NotAuthorized>
                    <div>
                        <a href="login" class="rz-ripple rz-button" style="color: white !important; padding: 5px">Login</a>
                        <a href="create_account" class="rz-button rz-ripple" style="color: white !important; padding: 5px;">Create Account</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        @Body
    </RadzenBody>
    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" >
            <p>Powered by: AlterForm</p>
            <a href="https://gittyup.donkhub.com/hawlton/AlterForm.git" class="rz-link" >Gitea</a>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>
</CascadingAuthenticationState>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
