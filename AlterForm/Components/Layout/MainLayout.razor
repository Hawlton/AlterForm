@using AlterForm.Client.Pages.Islands
@inherits LayoutComponentBase


<RadzenComponents @rendermode="InteractiveWebAssembly"></RadzenComponents>
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center", JustifyContent="JustifyContent.SpaceBetween" Style="padding-inline: 10px">
            <div class="header-segment">
                <MainMenu></MainMenu>
                <h3>AlterForm</h3>
            </div>
            <RadzenLabel Text="ProfileMenu"></RadzenLabel>
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        @Body
    </RadzenBody>
    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" >
            <p>Powered by: AlterForm</p>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
