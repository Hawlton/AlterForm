@using Microsoft.AspNetCore.Components.Authorization
@using Radzen.Blazor
@rendermode InteractiveWebAssembly

<RadzenMenu Flyout="true" ClickToOpen="false">
    <AuthorizeView>
        <Authorized>
            <RadzenMenuItem Text="Upload" Icon="upload" Path="upload"></RadzenMenuItem>
        </Authorized>
    </AuthorizeView>
    <RadzenMenuItem Text="Search" Icon="search" Path="search"></RadzenMenuItem>
    <RadzenMenuItem Text="Help" Icon="help">
        <RadzenMenuItem Text="Report an issue" Icon="feedback" Path="feedback"></RadzenMenuItem>
        <RadzenMenuItem Text="Contact Us" Icon="support_agent" Path="contact"></RadzenMenuItem>
        <RadzenMenuItem Text="FAQ" Icon="question_mark" Path="faq"></RadzenMenuItem>
    </RadzenMenuItem>
    <AuthorizeView Roles="Administrator">
        <Authorized>
        <RadzenMenuItem Text="Admin" Icon="admin_panel_settings">
            <RadzenMenuItem Text="Site Settings" Icon="settings" Path="admin/site_settings"></RadzenMenuItem>
            <RadzenMenuItem Text="Manage Users" Icon="person" Path="admin/manage_users"></RadzenMenuItem>
            <RadzenMenuItem Text="Manage Posts" Icon="dynamic_feed" Path="admin/manage_posts"></RadzenMenuItem>
        </RadzenMenuItem>
        </Authorized>
    </AuthorizeView>
</RadzenMenu>