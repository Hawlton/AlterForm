@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient http
@inject NavigationManager nav

<AuthorizeView>
    <Authorized>
        <RadzenProfileMenu>
            <Template>
                <RadzenIcon Icon="account_circle"></RadzenIcon>
                <RadzenLabel Text="@context?.User.Identity?.Name" ></RadzenLabel>
            </Template>
            <ChildContent>
                <RadzenProfileMenuItem Text="My Gallery" Icon="art_track"></RadzenProfileMenuItem>
                <RadzenProfileMenuItem Text="Account Settings" Icon="settings"></RadzenProfileMenuItem>
                <RadzenProfileMenuItem Text="Logout" Action="api/auth/logout" Method="post" Icon="logout"></RadzenProfileMenuItem>
            </ChildContent>
        </RadzenProfileMenu>
    </Authorized>
    <NotAuthorized>
        <div style="margin-top: 3px;">
            <a href="login" class="rz-button rz-ripple af-button">Login</a>
            <a href="create_account" class="rz-button rz-ripple af-button">Create Account</a>
        </div>
    </NotAuthorized>
</AuthorizeView>
