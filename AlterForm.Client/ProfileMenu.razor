@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject HttpClient http
@inject NavigationManager nav

<AuthorizeView>
    <Authorized>
        <RadzenProfileMenu>
            <Template>
                <img src="favicon.png" />
                <RadzenLabel Text="@context.User.Identity.Name" ></RadzenLabel>
            </Template>
            <ChildContent>
                <RadzenProfileMenuItem Text="My Gallery" Icon="art_track"></RadzenProfileMenuItem>
                <RadzenProfileMenuItem Text="Account Settings" Icon="settings"></RadzenProfileMenuItem>
                <RadzenProfileMenuItem Text="Logout" Action="api/auth/logout" Method="post" Icon="logout"></RadzenProfileMenuItem>
            </ChildContent>
        </RadzenProfileMenu>
    </Authorized>
        <NotAuthorized>
            <div>
                <a href="login" class="rz-ripple rz-button" style="color: white !important; padding: 5px">Login</a>
                <a href="create_account" class="rz-button rz-ripple" style="color: white !important; padding: 5px;">Create Account</a>
            </div>
        </NotAuthorized>
</AuthorizeView>
